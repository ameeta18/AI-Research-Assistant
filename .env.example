GOOGLE_API_KEY=your_google_api_key_here
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key_here
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ai-research-assistant
LANGSMITH_TRACING_SAMPLING_RATE=1.0
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=false
CACHE_TTL_SECONDS=900
CACHE_KEY_PREFIX=ai-researcher
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=1
DATABASE_ENABLED=false
DATABASE_URL=postgresql+psycopg://ai_researcher:local-development-only@localhost:5432/ai_researcher
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_DB=ai_researcher
POSTGRES_USER=ai_researcher
POSTGRES_PASSWORD=local-development-only
LANGGRAPH_STRICT_MSGPACK=true
APP_ENV=development
APP_PORT=8501
LOG_LEVEL=INFO
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.3
EMBEDDING_MODEL=models/gemini-embedding-001
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
ARXIV_MAX_RESULTS=5
SESSION_TTL_MINUTES=60
MAX_ACTIVE_SESSIONS=100
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=30
HTTP_MAX_ATTEMPTS=3
HTTP_BACKOFF_SECONDS=1
HTTP_JITTER_SECONDS=0.5
HTTP_MAX_RETRY_DELAY_SECONDS=30
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
MAX_SEARCH_QUERY_CHARS=500
MAX_SEARCH_RESULTS=10
MAX_CHAT_MESSAGE_CHARS=10000
MAX_PAPER_TITLE_CHARS=500
MAX_RETRIEVAL_K=10
MAX_PDF_BYTES=20000000
MAX_PDF_PAGES=200
MAX_PDF_TEXT_CHARS=2000000
LATEX_COMPILE_TIMEOUT_SECONDS=120
MAX_LATEX_CHARS=200000
